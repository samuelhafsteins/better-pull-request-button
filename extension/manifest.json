{
  "manifest_version": 3,
  "name": "Better Pull Request Button",
  "version": "1.1.0",
  "description": "Apply your saved default filter when opening Pull requests on GitHub.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/pull-request-16.png",
    "32": "icons/pull-request-32.png",
    "48": "icons/pull-request-48.png",
    "128": "icons/pull-request-128.png"
  },
  "action": {
    "default_title": "Configure your pull request filter",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/pull-request-16.png",
      "32": "icons/pull-request-32.png",
      "48": "icons/pull-request-48.png",
      "128": "icons/pull-request-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["filter.js", "dropdown.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "better-pull-request-button@samuelhafsteins.github.io",
      "strict_min_version": "109.0"
    }
  }
}
